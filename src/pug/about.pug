doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='About Cameron K. Brooks — graduate researcher in Electrical & Computer Engineering at Western University — and where to find me across academic, development, and social platforms.')
        meta(name='author', content='Cameron K. Brooks')

        title About Me

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Header — mission ------------------------------------------------
            header.py-5
                .container.px-5
                    .row.justify-content-center
                        .col-lg-8.col-xxl-6
                            .text-center.my-5
                                h1.fw-bolder.mb-3 My mission is to make building and sharing technology easy, accessible, and sustainable.
                                p.lead.fw-normal.text-muted.mb-0 I strongly advocate for the principles of open-source, the maker movement, and the right-to-repair, all of which center around empowering users to have control over and a deep understanding of the technology they rely on.

            // Profiles section ------------------------------------------------
            section.py-5.bg-light
                .container.px-5.my-5
                    .text-center.mb-5
                        h2.fw-bolder My Profiles
                        p.lead.fw-normal.text-muted.mb-0 Find me across academic, development, and social platforms.
                    .row.gx-5
                        .col-lg-4.mb-5.mb-lg-0
                            h3.h5.fw-bolder.mb-3 Academic
