doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='About Cameron K. Brooks — graduate researcher in Electrical & Computer Engineering at Western University — and where to find me across academic, development, and social platforms.')
        meta(name='author', content='Cameron K. Brooks')

        title About Me

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Header — mission ------------------------------------------------
            header.py-5
                .container.px-5
                    .row.justify-content-center
                        .col-lg-8.col-xxl-6
                            .text-center.my-5
                                h1.fw-bolder.mb-3 My mission is to make building and sharing technology easy, accessible, and sustainable.
                                p.lead.fw-normal.text-muted.mb-0 I strongly advocate for the principles of open-source, the maker movement, and the right-to-repair, all of which center around empowering users to have control over and a deep understanding of the technology they rely on.

            // Background section ----------------------------------------------
            section.py-5.border-top
                .container.px-5.my-5
                    .row.gx-5
                        .col-lg-6.mb-5.mb-lg-0
                            h2.fw-bolder.mb-4 Education
                            ul.list-unstyled
                                li.mb-3
                                    .fw-bolder MESc, Electrical &amp; Computer Engineering — Western University
                                    .text-muted Robotics &amp; Controls · in progress, supervised by Dr. Joshua M. Pearce
                                    .small Thesis: an open-source hardware–software framework for composable and modular scientific and industrial systems.
                                li.mb-3
                                    .fw-bolder BESc, Electrical Engineering — Western University
                                    .text-muted 2025
                        .col-lg-6
                            h2.fw-bolder.mb-4 Experience
                            ul.list-unstyled
                                li.mb-3
                                    .fw-bolder Founder — Integrum Systems
                                    .text-muted 2026 – present
                                li.mb-3
                                    .fw-bolder Graduate Research Student — Dept. of Electrical &amp; Computer Engineering, Western
                                    .text-muted 2025 – present
                                li.mb-3
                                    .fw-bolder Technical Research Support Associate — FAST Research Group, Western
                                    .text-muted 2021 – 2024
                                li.mb-3
                                    .fw-bolder Western Engineering Rocketry Team
                                    .text-muted Payload Subteam Lead 2023/24 · Co-Lead 2024/25 · Technical Advisor 2025/26
                                li.mb-3
                                    .fw-bolder Teaching Associate — How to Change the World
                                    .text-muted 2022 – 2025
                                li.mb-3
                                    .fw-bolder Volunteer Engineering Intern — Field Ready
                                    .text-muted 2022 – 2023

            // Through-line section --------------------------------------------
            section.py-5.bg-light
                .container.px-5.my-5
                    .text-center.mb-5
                        h2.fw-bolder From research group to runtime
                        p.lead.fw-normal.text-muted.mb-0 Most of my work follows one line, from university research to an open hardware standard, the software that drives it, and a company.
                    .row.gx-5.row-cols-1.row-cols-md-2.row-cols-xl-4
                        .col.mb-5
                            h3.h5.fw-bolder
                                a(href='https://github.com/uwo-fast' target='_blank') FAST Research Group
                            p.mb-0 Free Appropriate Sustainable Technology, Western University. Open-source scientific equipment and lab hardware; I maintain most of the group's public repositories.
                        .col.mb-5
                            h3.h5.fw-bolder
                                a(href='https://github.com/feastorg' target='_blank') FEAST
                            p.mb-0 An open ecosystem for building modular automation devices, continuing the BREAD hardware standard. I lead its engineering: the standard, its CI, and the CRUMBS messaging protocol.
                        .col.mb-5
                            h3.h5.fw-bolder
                                a(href='https://github.com/anolishq' target='_blank') Anolis
                            p.mb-0 A capability-oriented machine control runtime, developed and validated against FEAST hardware. In active development.
                        .col.mb-5
                            h3.h5.fw-bolder
                                a(href='https://integrumsys.com' target='_blank') Integrum Systems
                            p.mb-0 The systems-integration company I founded in 2026.

            // Principles section ----------------------------------------------
            section.py-5
                .container.px-5.my-5
                    .text-center.mb-5
                        h2.fw-bolder Principles
                    .row.gx-5
                        .col-lg-6.mb-5.mb-lg-0
                            h3.h5.fw-bolder Accessibility &amp; Collaboration
                            p.mb-0 Lowering the barriers to building, sharing, and maintaining technology — open tools and documentation that others can pick up, use, and extend.
                        .col-lg-6
                            h3.h5.fw-bolder Composability and Modularity
                            p.mb-0 Designing hardware and software as modular, recombinable parts with clear interfaces, so systems can be assembled and adapted across domains.

