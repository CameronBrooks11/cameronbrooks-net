doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='The principles behind my work: accessibility, collaboration, composability, and modularity in open hardware and software.')
        meta(name='author', content='Cameron K. Brooks')

        title Pillars

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Page Content
            section.py-5
                .container.px-5.my-5
                    .text-center.mb-5
                        h1.fw-bolder Research &amp; Initiative Pillars
                        p.lead.fw-normal.text-muted.mb-0 The key areas where my work focuses.
                    .row.gx-5
                        .col-xl-8
                            #accordionExample.accordion.mb-5.mb-xl-0
                                .accordion-item
                                    h3#headingOne.accordion-header
                                        button.accordion-button(type='button' data-bs-toggle='collapse' data-bs-target='#collapseOne' aria-expanded='true' aria-controls='collapseOne')
                                            | Accessibility &amp; Collaboration
                                    #collapseOne.accordion-collapse.collapse.show(aria-labelledby='headingOne' data-bs-parent='#accordionExample')
                                        .accordion-body Lowering the barriers to building, sharing, and maintaining technology — open tools and documentation that others can pick up, use, and extend.
                                .accordion-item
                                    h3#headingTwo.accordion-header
                                        button.accordion-button.collapsed(type='button' data-bs-toggle='collapse' data-bs-target='#collapseTwo' aria-expanded='false' aria-controls='collapseTwo')
                                            | Composability and Modularity
                                    #collapseTwo.accordion-collapse.collapse(aria-labelledby='headingTwo' data-bs-parent='#accordionExample')
                                        .accordion-body Designing hardware and software as modular, recombinable parts with clear interfaces, so systems can be assembled and adapted across domains.
                        .col-xl-4
                            .card.border-0.bg-light.mt-xl-5
                                .card-body.p-4.py-lg-5
                                    .d-flex.align-items-center.justify-content-center
                                        .text-center
                                            .h6.fw-bolder Have more questions?
                                            p.text-muted.mb-0
                                                | Contact me using the form
                                                br
                                                a(href='contact.html') here

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
