doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Cameron K. Brooks, graduate researcher in Electrical & Computer Engineering at Western University, building open, modular hardware and software systems.')
        meta(name='author', content='Cameron K. Brooks')

        title Cameron K. Brooks

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Header
            header.bg-dark.py-5
                .container.px-5
                    .row.gx-5.align-items-center.justify-content-center
                        .col-lg-8.col-xl-7.col-xxl-6
                            .my-5.text-center.text-xl-start
                                h1.display-5.fw-bolder.text-white.mb-2 Open, modular systems, from the board to the runtime.
                                p.lead.fw-normal.text-white-50.mb-4 I'm a graduate researcher in Electrical &amp; Computer Engineering at Western University. I design open-source hardware and software for scientific and industrial systems, built from parts that can be recombined, verified, and shared. I try to make things that are generally useful.
                                .d-grid.gap-3.d-sm-flex.justify-content-sm-center.justify-content-xl-start
                                    a.btn.btn-primary.btn-lg.px-4.me-sm-3(href='work.html') Selected Work
                                    a.btn.btn-outline-light.btn-lg.px-4(href='publications.html') Publications
                        .col-xl-5.col-xxl-6.d-none.d-xl-block.text-center
                            img.img-fluid.rounded-3.my-5(src='assets/recurtreescad_force_points.PNG', alt='Force points on a recursive tree model generated in OpenSCAD')

            // Features section ------------------------------------------------
            section#features.py-5
                .container.px-5.my-5
                    .row.gx-5
                        .col-lg-4.mb-5.mb-lg-0
                            h2.fw-bolder.mb-0 What I work on.
                        .col-lg-8
                            .row.gx-5.row-cols-1.row-cols-md-2
                                .col.mb-5.h-100
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-tools
                                    h2.h5 Selected Work
                                    p.mb-0
                                        | Parametric CAD tooling, hardware-engineering verification, open lab hardware, and embedded control.
                                    a.btn.btn-light.btn-sm.mt-2(href='work.html') See Selected Work
                                .col.mb-5.h-100
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-book
                                    h2.h5 Publications
                                    p.mb-0
                                        | Four peer-reviewed journal articles on open-source hardware and distributed manufacturing.
                                    a.btn.btn-light.btn-sm.mt-2(href='publications.html') See Publications
                                .col.mb-5.h-100
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-building
                                    h2.h5 Integrum Systems Inc.
                                    p.mb-0
                                        | The systems-integration company I founded in 2026.
                                    a.btn.btn-light.btn-sm.mt-2(href='https://integrumsys.com' target='_blank') Visit Integrum Systems Inc.
                                .col.mb-5.h-100
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-graph-up
                                    h2.h5 Knowledge Graph
                                    p.mb-0
                                        | An interactive graph of the connections between my ideas, projects, and contributions.
                                    a.btn.btn-light.btn-sm.mt-2(href='https://nexus.cameronbrooks.net/' target='_blank') Visit Knowledge Graph

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
